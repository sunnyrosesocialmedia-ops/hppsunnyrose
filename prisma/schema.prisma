datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

// File asli disimpan privat di STORAGE_DIR/originals/{id}.{originalExt}, hanya bisa
// diakses lewat /api/download/[token] setelah pembayaran lunas. Preview berwatermark
// disimpan di STORAGE_DIR/previews/{id}.jpg dan dilayani publik lewat /api/preview/[id].
model Photo {
  id           String      @id @default(cuid())
  title        String
  description  String?
  price        Int // harga dalam Rupiah (bilangan bulat)
  category     String?
  originalExt  String // ekstensi file asli, mis. "jpg", "png"
  previewUrl   String // = /api/preview/{id}
  width        Int?
  height       Int?
  published    Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  orderItems   OrderItem[]
}

// SQLite tidak mendukung enum native, jadi status disimpan sebagai String.
// Nilai yang valid: PENDING | PAID | FAILED | EXPIRED | CANCELLED (lihat src/lib/types.ts)
model Order {
  id              String      @id @default(cuid())
  buyerName       String
  buyerEmail      String
  status          String      @default("PENDING")
  totalAmount     Int
  snapToken       String?
  snapRedirectUrl String?
  paidAt          DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]

  @@index([buyerEmail])
}

model OrderItem {
  id            String    @id @default(cuid())
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id])
  photoId       String
  photo         Photo     @relation(fields: [photoId], references: [id])
  price         Int
  downloadToken String    @unique
  downloadCount Int       @default(0)
  maxDownloads  Int       @default(5)
  expiresAt     DateTime?

  @@index([orderId])
  @@index([downloadToken])
}
