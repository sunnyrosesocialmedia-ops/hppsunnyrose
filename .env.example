# Database PostgreSQL. Untuk deploy ke Vercel, tambahkan Postgres lewat tab
# "Storage" di project Vercel Anda (mis. Neon/Vercel Postgres) — nanti dapat
# connection string yang tinggal ditempel di sini. Untuk lokal, bisa pakai
# Postgres di komputer sendiri atau langsung pakai database Neon yang sama.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# URL publik aplikasi (dipakai untuk link download di email)
APP_URL="http://localhost:3000"

# Rahasia untuk menandatangani session login admin — isi string acak & panjang
SESSION_SECRET="ganti-dengan-string-acak-yang-panjang"

# Cloudinary (penyimpanan foto) — buat akun gratis di cloudinary.com
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
WATERMARK_TEXT="PREVIEW - SUNNY ROSE"

# Nomor WhatsApp fotografer (format 08xx atau 62xx) untuk tombol "Chat WhatsApp"
# yang dipakai pembeli mengonfirmasi pembayaran. Pembayaran dikonfirmasi manual
# oleh fotografer lewat tombol "Tandai Lunas" di dashboard admin.
WHATSAPP_NUMBER=""

# SMTP untuk kirim email link download (contoh: Gmail App Password, atau layanan seperti Resend/Mailgun/SMTP provider lain)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Sunny Rose Photo <no-reply@example.com>"

# Dipakai sekali oleh `npm run create-admin` untuk membuat akun fotografer pertama
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Fotografer"
